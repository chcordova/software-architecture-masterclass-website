---
import Layout from '../layouts/Layout.astro';

interface ModuleCard {
  id: string;
  step: string;
  title: string;
  desc: string;
  tags: string[];
  href: string;
  isAvailable: boolean;
}

const getBase = (path: string) => {
  const base = import.meta.env.BASE_URL;
  const safeBase = base.endsWith('/') ? base : base + '/';
  return safeBase + path;
};

const modules: ModuleCard[] = [
  {
    id: '01',
    step: 'Módulo 1',
    title: 'Fundamentos & Atributos de Calidad',
    desc: 'Principios de diseño, Ley de Conway, deuda técnica y el equilibrio entre escalabilidad y mantenibilidad.',
    tags: ['Quality Attributes', 'Trade-offs', 'SOLID'],
    href: getBase('modulos/01-fundamentos'),
    isAvailable: true,
  },
  {
    id: '02',
    step: 'Módulo 2',
    title: 'Arquitectura en Capas & Clean Architecture',
    desc: 'Separación de responsabilidades, regla de dependencia, desacoplamiento del framework e inversión de control.',
    tags: ['Clean Arch', 'Onion', 'Separation of Concerns'],
    href: getBase('modulos/02-arquitectura-capas'),
    isAvailable: true,
  },
  {
    id: '03',
    step: 'Módulo 3',
    title: 'Arquitectura Hexagonal (Ports & Adapters)',
    desc: 'Aislamiento del núcleo del dominio, diseño guiado por el dominio (DDD) y contratos de infraestructura.',
    tags: ['Ports & Adapters', 'DDD', 'Testability'],
    href: getBase('modulos/03-arquitectura-hexagonal'),
    isAvailable: true,
  },
  {
    id: '04',
    step: 'Módulo 4',
    title: 'Sistemas Distribuidos & Event-Driven',
    desc: 'Teorema CAP, consistencia eventual, patrones de mensajería asíncrona, Outbox pattern y Sagas.',
    tags: ['Kafka/RabbitMQ', 'Eventual Consistency', 'Sagas'],
    href: getBase('modulos/04-sistemas-distribuidos'),
    isAvailable: true,
  },
  {
    id: '05',
    step: 'Módulo 5',
    title: 'Matriz Comparativa de Decisiones (ADRs)',
    desc: 'Metodología para documentar Architectural Decision Records y evaluar trade-offs con rigor técnico.',
    tags: ['ADR', 'Decision Matrix', 'Governance'],
    href: getBase('modulos/05-comparativa'),
    isAvailable: true,
  },
  {
    id: '06',
    step: 'Módulo 6',
    title: 'Evaluación Práctica & Quizzes',
    desc: 'Ponte a prueba con retos de diseño de sistemas reales y cuestionarios diagnósticos interactivos.',
    tags: ['Interactive Quiz', 'Case Studies', 'Review'],
    href: getBase('modulos/06-quiz'),
    isAvailable: true,
  },
];
---

<Layout title="Software Architecture Masterclass | Learning Path" showSidebar={false} isProse={false}>
  <!-- Hero Section -->
  <section class="text-center py-12 md:py-20 max-w-4xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-indigo-200 bg-indigo-50/80 text-xs font-semibold text-indigo-700 mb-6">
      <span class="w-2 h-2 rounded-full bg-indigo-600 animate-pulse"></span>
      Interactive Learning Path 2026
    </div>
    
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.15]">
      Domina el Arte del <span class="bg-gradient-to-r from-indigo-600 to-violet-600 bg-clip-text text-transparent">Diseño de Sistemas</span>
    </h1>
    
    <p class="mt-6 text-lg sm:text-xl text-slate-600 leading-relaxed max-w-2xl mx-auto">
      De monolitos modulares a arquitecturas distribuidas orientadas a eventos. Comprende los verdaderos <em>trade-offs</em>, patrones y decisiones que definen el software de alto nivel.
    </p>

    <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a
        href={getBase('modulos/01-fundamentos')}
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-indigo-600 text-white font-semibold text-base shadow-lg shadow-indigo-200 hover:bg-indigo-700 hover:shadow-indigo-300 transition-all text-center"
      >
        Comenzar Ruta de Aprendizaje →
      </a>
      <a
        href="#syllabus"
        class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-white border border-slate-200 text-slate-700 font-semibold text-base hover:bg-slate-50 transition-all text-center"
      >
        Explorar Syllabus
      </a>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-16 pt-12 border-t border-slate-200">
      <div class="p-4 bg-white rounded-xl border border-slate-100 shadow-sm">
        <div class="text-2xl font-bold text-indigo-600">6</div>
        <div class="text-xs font-medium text-slate-500 uppercase mt-1">Módulos Core</div>
      </div>
      <div class="p-4 bg-white rounded-xl border border-slate-100 shadow-sm">
        <div class="text-2xl font-bold text-indigo-600">+15</div>
        <div class="text-xs font-medium text-slate-500 uppercase mt-1">Patrones de Diseño</div>
      </div>
      <div class="p-4 bg-white rounded-xl border border-slate-100 shadow-sm">
        <div class="text-2xl font-bold text-indigo-600">100%</div>
        <div class="text-xs font-medium text-slate-500 uppercase mt-1">Práctico con TypeScript</div>
      </div>
      <div class="p-4 bg-white rounded-xl border border-slate-100 shadow-sm">
        <div class="text-2xl font-bold text-indigo-600">ADRs</div>
        <div class="text-xs font-medium text-slate-500 uppercase mt-1">Decisiones Reales</div>
      </div>
    </div>
  </section>

  <!-- Syllabus / Roadmap Section -->
  <section id="syllabus" class="py-12 max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">Ruta Formativa de Arquitectura</h2>
      <p class="text-slate-600 mt-2 text-sm sm:text-base">Evolución progresiva desde los conceptos elementales hasta sistemas resilientes en producción.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {modules.map((module) => (
        <div class="flex flex-col bg-white rounded-2xl border border-slate-200 p-6 shadow-sm hover:shadow-md hover:border-indigo-300 transition-all relative overflow-hidden group">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-md">
              {module.step}
            </span>
            {module.isAvailable ? (
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
                Disponible
              </span>
            ) : (
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-500">
                Próximamente
              </span>
            )}
          </div>

          <h3 class="text-xl font-bold text-slate-900 group-hover:text-indigo-600 transition-colors mb-2">
            {module.title}
          </h3>

          <p class="text-slate-600 text-sm leading-relaxed mb-6 flex-1">
            {module.desc}
          </p>

          <div class="flex flex-wrap gap-1.5 mb-6">
            {module.tags.map((tag) => (
              <span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded">
                #{tag}
              </span>
            ))}
          </div>

          {module.isAvailable ? (
            <a
              href={module.href}
              class="w-full py-2.5 px-4 rounded-lg bg-indigo-50 hover:bg-indigo-600 text-indigo-600 hover:text-white font-medium text-sm transition-colors text-center block"
            >
              Iniciar Módulo →
            </a>
          ) : (
            <button
              disabled
              class="w-full py-2.5 px-4 rounded-lg bg-slate-100 text-slate-400 font-medium text-sm cursor-not-allowed text-center"
            >
              En desarrollo
            </button>
          )}
        </div>
      ))}
    </div>
  </section>
</Layout>
